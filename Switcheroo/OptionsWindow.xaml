<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Switcheroo.OptionsWindow" Title="Switcheroo Options" ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="False" WindowStyle="ToolWindow" Background="{x:Static SystemColors.WindowBrush}" Height="650" Width="800" MinWidth="620" MinHeight="380" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <GroupBox Header="Shortcuts" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="HotKeyCheckBox" Margin="0,5,0,4" Checked="HotKeyCheckBox_Checked" Unchecked="HotKeyCheckBox_OnUnchecked">
                                <TextBlock TextWrapping="Wrap" Text="Activate Switcheroo with this shortcut:" />
                            </CheckBox>
                            <TextBox Name="HotkeyPreview" Margin="25,5,0,10" PreviewKeyDown="HotkeyPreview_OnPreviewKeyDown" GotFocus="HotkeyPreview_OnGotFocus" LostFocus="HotkeyPreview_OnLostFocus" Width="150" HorizontalAlignment="Left" />
                            <CheckBox Name="AltTabCheckBox" Checked="AltTabCheckBox_OnChecked" Unchecked="AltTabCheckBox_OnUnchecked" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Activate Switcheroo with Alt+Tab" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Use Switcheroo instead of the integrated task switcher in Windows.
            </TextBlock>
                            <CheckBox Name="PreviousAppCheckBox" Margin="0,5,0,4" Checked="PreviousAppCheckBox_Checked" Unchecked="PreviousAppCheckBox_OnUnchecked">
                                <TextBlock TextWrapping="Wrap" Text="Switch back to previous app with this shortcut:" />
                            </CheckBox>
                            <TextBox Name="PreviousAppPreview" Margin="25,5,0,10" PreviewKeyDown="PreviousAppPreview_OnPreviewKeyDown" GotFocus="PreviousAppPreview_OnGotFocus" LostFocus="PreviousAppPreview_OnLostFocus" Width="150" HorizontalAlignment="Left" />
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Toggle between the current and previous window without showing the overlay.
            </TextBlock>
                            <CheckBox Name="AzShortcutsCheckBox" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Show 0-9 / a-z / A-Z shortcuts in the overlay" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Press the displayed <Span FontFamily="Consolas" FontWeight="Bold">0-9</Span>, <Span FontFamily="Consolas" FontWeight="Bold">a-z</Span> (no Shift) or <Span FontFamily="Consolas" FontWeight="Bold">A-Z</Span> (with Shift) key to jump straight to that window.
            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Behavior" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="AutoSwitch" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Automatically switch window when releasing Alt + Tab" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Faster and more native-like swiching between windows.<LineBreak />
                                <LineBreak />
                Use <Span FontFamily="Consolas" FontWeight="Bold">Ctrl + Alt + Tab</Span> for displaying Switcheroo with search activated, or
                press <Span FontFamily="Consolas" FontWeight="Bold">Alt + S</Span> when the Switcheroo overlay appears.
            </TextBlock>
                            <CheckBox Name="RecentOnTopCheckBox" Margin="0,5,0,4" Checked="RecentOnTopCheckBox_OnChecked" Unchecked="RecentOnTopCheckBox_OnUnchecked">
                                <TextBlock TextWrapping="Wrap" Text="Keep recently used windows on top" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="25,2,5,0">
                                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="DimGray" Text="Pinned recent windows:" />
                                <TextBox Name="RecentOnTopCountBox" Width="40" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                The previous app stays first so <Span FontFamily="Consolas" FontWeight="Bold">Enter</Span> still switches back to it; the rest of the pinned group is sorted alphabetically to keep the list order stable.
            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <GroupBox Header="Appearance" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="MultiColumnCheckBox" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Use multi-column layout for many windows" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                When there are many open windows, show them in side-by-side columns instead of a single tall list. You can resize the window to control how many columns fit.
            </TextBlock>
                            <CheckBox Name="TaskbarBadgesCheckBox" Margin="0,5,0,4" Checked="TaskbarBadgesCheckBox_OnChecked" Unchecked="TaskbarBadgesCheckBox_OnUnchecked">
                                <TextBlock TextWrapping="Wrap" Text="Show quick-switch keys on taskbar buttons" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="25,2,5,0">
                                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="DimGray" Text="Auto-hide badges after (seconds, 0 = never):" />
                                <TextBox Name="BadgeTimeoutBox" Width="40" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                While the overlay is open, draw each window's <Span FontFamily="Consolas" FontWeight="Bold">0-9 / a-z / A-Z</Span> key at the top-left corner of its taskbar button. Requires the overlay shortcuts to be enabled.
            </TextBlock>
                            <CheckBox Name="SwitchHighlightCheckBox" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Highlight the window you switch to" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">Briefly show an accent border and a soft blue dot at the center of the activated window.</TextBlock>
                            <CheckBox Name="OpenUsageHintsByDefaultCheckBox" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Open the usage hints by default" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Expand the <Span FontFamily="Consolas" FontWeight="Bold">?</Span> help strip every time Switcheroo opens. You can still toggle it manually.
            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Run" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="RunAsAdministrator" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Run as Administrator *" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                This is needed if you want <Span FontFamily="Consolas" FontWeight="Bold">Alt + Tab</Span> to work when programs
                running with higher privileges than your user account are in focus.<LineBreak />
                                <LineBreak />
                                <Italic>* Requires a restart of Switcheroo</Italic>
                            </TextBlock>
                            <CheckBox Name="RunOnStartup" Margin="0,5,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Run on Startup" />
                            </CheckBox>
                            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap">
                Add Switcheroo to the Windows startup folder.
            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="Ok" Width="84" Margin="8,0,0,0" Padding="0,5" Click="Ok_Click" IsDefault="True">OK</Button>
            <Button Name="Cancel" Width="84" Margin="8,0,0,0" Padding="0,5" Click="Cancel_Click" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
