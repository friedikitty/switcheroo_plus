<Window x:Class="Switcheroo.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switcheroo Options" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" WindowStyle="ToolWindow" Background="{x:Static SystemColors.WindowBrush}" Height="520"
        MaxWidth="420">
    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="5,5,5,5">
            <CheckBox Name="HotKeyCheckBox" Margin="5,5,5,1" Checked="HotKeyCheckBox_Checked" Unchecked="HotKeyCheckBox_OnUnchecked">Activate Switcheroo with this shortcut:</CheckBox>
            <TextBox Name="HotkeyPreview" Margin="25,5,0,10"
                     PreviewKeyDown="HotkeyPreview_OnPreviewKeyDown"
                     GotFocus="HotkeyPreview_OnGotFocus"
                     LostFocus="HotkeyPreview_OnLostFocus"
                     Width="150"
                     HorizontalAlignment="Left"/>
            <CheckBox Name="AltTabCheckBox" Checked="AltTabCheckBox_OnChecked" Unchecked="AltTabCheckBox_OnUnchecked" Margin="5,5,5,1">Activate Switcheroo with Alt+Tab</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Use Switcheroo instead of the integrated task switcher in Windows.
            </TextBlock>
            <CheckBox Name="AutoSwitch" Margin="5,5,5,1">Automatically switch window when releasing Alt + Tab</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Faster and more native-like swiching between windows.<LineBreak />
                <LineBreak />
                Use <Span FontFamily="Consolas" FontWeight="Bold">Ctrl + Alt + Tab</Span> for displaying Switcheroo with search activated, or
                press <Span FontFamily="Consolas" FontWeight="Bold">Alt + S</Span> when the Switcheroo overlay appears.
            </TextBlock>
            <CheckBox Name="AzShortcutsCheckBox" Margin="5,5,5,1">Show 0-9 / a-z / A-Z shortcuts in the overlay</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Press the displayed <Span FontFamily="Consolas" FontWeight="Bold">0-9</Span>, <Span FontFamily="Consolas" FontWeight="Bold">a-z</Span> (no Shift) or <Span FontFamily="Consolas" FontWeight="Bold">A-Z</Span> (with Shift) key to jump straight to that window.
            </TextBlock>
            <CheckBox Name="MultiColumnCheckBox" Margin="5,5,5,1">Use multi-column layout for many windows</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                When there are many open windows, show them in side-by-side columns instead of a single tall list. You can resize the window to control how many columns fit.
            </TextBlock>
            <CheckBox Name="RecentOnTopCheckBox" Margin="5,5,5,1" Checked="RecentOnTopCheckBox_OnChecked" Unchecked="RecentOnTopCheckBox_OnUnchecked">Keep recently used windows on top</CheckBox>
            <StackPanel Orientation="Horizontal" Margin="25,2,5,0">
                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="DimGray" Text="Pinned recent windows:"/>
                <TextBox Name="RecentOnTopCountBox" Width="40" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock Margin="25,2,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                The previous app stays first so <Span FontFamily="Consolas" FontWeight="Bold">Enter</Span> still switches back to it; the rest of the pinned group is sorted alphabetically to keep the list order stable.
            </TextBlock>
            <CheckBox Name="TaskbarBadgesCheckBox" Margin="5,5,5,1" Checked="TaskbarBadgesCheckBox_OnChecked" Unchecked="TaskbarBadgesCheckBox_OnUnchecked">Show quick-switch keys on taskbar buttons</CheckBox>
            <StackPanel Orientation="Horizontal" Margin="25,2,5,0">
                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="DimGray" Text="Auto-hide badges after (seconds, 0 = never):"/>
                <TextBox Name="BadgeTimeoutBox" Width="40" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock Margin="25,2,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                While the overlay is open, draw each window's <Span FontFamily="Consolas" FontWeight="Bold">0-9 / a-z / A-Z</Span> key at the top-left corner of its taskbar button. Requires the overlay shortcuts to be enabled.
            </TextBlock>
            <CheckBox Name="SwitchHighlightCheckBox" Margin="5,5,5,1">Flash the window you switch to</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Briefly draws a thin accent border around the window that becomes active, so it is obvious where the switch landed. Applies to every switch, including <Span FontFamily="Consolas" FontWeight="Bold">Alt+Tab</Span>.
            </TextBlock>
            <CheckBox Name="OpenUsageHintsByDefaultCheckBox" Margin="5,5,5,1">Open the usage hints by default</CheckBox>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Expand the <Span FontFamily="Consolas" FontWeight="Bold">?</Span> help strip every time Switcheroo opens. You can still toggle it manually.
            </TextBlock>
            <CheckBox Name="PreviousAppCheckBox" Margin="5,5,5,1" Checked="PreviousAppCheckBox_Checked" Unchecked="PreviousAppCheckBox_OnUnchecked">Switch back to previous app with this shortcut:</CheckBox>
            <TextBox Name="PreviousAppPreview" Margin="25,5,0,10"
                     PreviewKeyDown="PreviousAppPreview_OnPreviewKeyDown"
                     GotFocus="PreviousAppPreview_OnGotFocus"
                     LostFocus="PreviousAppPreview_OnLostFocus"
                     Width="150"
                     HorizontalAlignment="Left"/>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Toggle between the current and previous window without showing the overlay.
            </TextBlock>
            <CheckBox x:Name="RunAsAdministrator" Margin="5,5,5,1" Content="Run as Administrator *"/>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                This is needed if you want <Span FontFamily="Consolas" FontWeight="Bold">Alt + Tab</Span> to work when programs
                running with higher privileges than your user account are in focus.<LineBreak />
                <LineBreak />
                <Italic>* Requires a restart of Switcheroo</Italic>
            </TextBlock>
            <CheckBox Name="RunOnStartup" Margin="5,5,5,1" Content="Run on Startup"/>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap">
                Add Switcheroo to the Windows startup folder.
            </TextBlock>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Name="Ok" Width="60" Click="Ok_Click" IsDefault="True" Margin="0,0,5,0" Grid.Column="0">OK</Button>
                <Button Name="Cancel" Width="60" Click="Cancel_Click" IsCancel="True" Margin="5,0,0,0" Grid.Column="1">Cancel</Button>
            </Grid>
        </StackPanel>
    </Grid>

</Window>
